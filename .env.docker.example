# WebAgent Docker compose environment.
# Copy to .env.docker for local Docker runs. Do not commit real secrets.

# Frontend build/runtime
WEB_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
NEXT_PUBLIC_API_ADAPTER=fastapi

# FastAPI
APP_NAME=WebAgent API
ENVIRONMENT=local
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Storage
POSTGRES_DB=webagent
POSTGRES_USER=webagent
POSTGRES_PASSWORD=webagent_password
DATABASE_URL=postgresql+asyncpg://webagent:webagent_password@postgres:5432/webagent
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-local-docker-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_DEV_AUTH_FALLBACK=true

# Model gateway
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# Agent runtime
# For Docker local packaging, Hermes/OpenClaw are expected to be reachable from
# the API container through a mounted binary or a network gateway.
AGENT_RUNTIME_DEFAULT=hermes
OPENCLAW_BASE_URL=ws://host.docker.internal:18789
OPENCLAW_AGENT_ID=main
OPENCLAW_CLI_PATH=openclaw
OPENCLAW_COMMAND_TIMEOUT_SECONDS=600
OPENCLAW_MODE=gateway_cli
HERMES_BASE_URL=http://host.docker.internal:8642
HERMES_CLI_PATH=hermes
HERMES_HOME=/app/runtime/hermes-home
HERMES_SKILLS_DIR=/app/runtime/hermes-skills
HERMES_WSL_DISTRIBUTION=
OPENCLAW_SKILLS_DIR=/app/runtime/openclaw-skills

# Agent run limits
AGENT_RUN_IDLE_TIMEOUT_SECONDS=1800
AGENT_RUN_OVERALL_TIMEOUT_SECONDS=7200
AGENT_RUN_PPT_EXPORT_TIMEOUT_SECONDS=180
AGENT_RUN_EVENT_POLL_INTERVAL_SECONDS=1
AGENT_RUN_QUEUE_ENABLED=true
AGENT_RUN_QUEUE_NAME=agent-runs
AGENT_RUN_WORKSPACE_ROOT=/app/runtime/agent-runs
AGENT_RUNTIME_USER_ROOT=/app/runtime/users
AGENT_ADAPTER_LIMIT_SCOPE=per_user
WORKER_CONCURRENCY=1
AGENT_ADAPTER_DEFAULT_CONCURRENCY=1
HERMES_ADAPTER_CONCURRENCY=1
OPENCLAW_ADAPTER_CONCURRENCY=1
AGENT_ADAPTER_LOCK_POLL_SECONDS=2
AGENT_ADAPTER_LOCK_STATUS_INTERVAL_SECONDS=30
AGENT_ADAPTER_LOCK_TTL_SECONDS=120
AGENT_ADAPTER_LOCK_WAIT_TIMEOUT_SECONDS=3600

# Artifact and cleanup
ARTIFACT_STORAGE_ENABLED=true
ARTIFACT_STORAGE_ROOT=/app/artifacts
CLEANUP_ENABLED=true
CLEANUP_INITIAL_DELAY_SECONDS=60
CLEANUP_INTERVAL_SECONDS=21600
CLEANUP_RUNTIME_FILE_MAX_AGE_DAYS=14
CLEANUP_DISCONNECTED_RUN_MAX_AGE_DAYS=30

# Skills update
SKILLS_UPDATE_ENABLED=true
SKILLS_UPDATE_REPO_URL=https://github.com/OpenSenseNova/SenseNova-Skills.git
SKILLS_UPDATE_BRANCH=
SKILLS_UPDATE_CACHE_DIR=/app/runtime/sensenova-skills
SKILLS_UPDATE_SOURCE_SUBDIR=.
SKILLS_UPDATE_TIMEZONE=Asia/Shanghai
SKILLS_UPDATE_WEEKDAY=4
SKILLS_UPDATE_HOUR=17
SKILLS_UPDATE_MINUTE=0
SKILLS_UPDATE_RUN_ON_STARTUP=false
