# WebAgent local development environment

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
NEXT_PUBLIC_API_ADAPTER=fastapi

# FastAPI
APP_NAME=WebAgent API
ENVIRONMENT=local
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Storage
DATABASE_URL=postgresql+asyncpg://webagent:webagent_password@localhost:5432/webagent
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Model gateway
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=

# Agent runtime
AGENT_RUNTIME_DEFAULT=hermes
OPENCLAW_BASE_URL=ws://127.0.0.1:18789
OPENCLAW_AGENT_ID=main
OPENCLAW_CLI_PATH=openclaw
OPENCLAW_COMMAND_TIMEOUT_SECONDS=600
OPENCLAW_MODE=gateway_cli
HERMES_BASE_URL=http://localhost:8642
HERMES_CLI_PATH=/home/zhuchangbiaozhu_xyl/.local/bin/hermes
HERMES_HOME=/home/zhuchangbiaozhu_xyl/.hermes
HERMES_WSL_DISTRIBUTION=Ubuntu
