# WebAgent local development environment

# Frontend
# Empty means the browser calls the same Next.js origin, and Next proxies /api to FastAPI.
NEXT_PUBLIC_API_BASE_URL=

# FastAPI
APP_NAME=WebAgent API
ENVIRONMENT=local
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
DATABASE_URL=postgresql+asyncpg://webagent:webagent_password@localhost:5432/webagent
REDIS_URL=redis://localhost:6379/0
UPLOAD_MAX_SIZE_BYTES=26214400
ARTIFACT_STORAGE_ENABLED=true
# Windows example: D:\WebAgentArtifacts; Linux example: /var/lib/webagent/artifacts
ARTIFACT_STORAGE_ROOT=runtime/artifacts
ARTIFACT_PREVIEW_CACHE_ROOT=runtime/artifact-previews
# Optional explicit path, e.g. C:\Program Files\LibreOffice\program\soffice.com
LIBREOFFICE_PATH=
PPTX_PREVIEW_MAX_SLIDES=100
PPTX_PREVIEW_TIMEOUT_SECONDS=120

# Auth
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Model credential encryption (Fernet key; scripts/dev-api.ps1 creates a local key if empty)
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONFIG_ENCRYPTION_PREVIOUS_KEYS=

# Model gateway
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=

# Hermes runtime
HERMES_CLI_PATH=hermes
HERMES_HOME=~/.hermes
HERMES_WSL_DISTRIBUTION=Ubuntu
