# WebAgent production environment template
#
# Copy the relevant values into your deployment platform, process manager, or
# service-specific env files. Never commit real secrets.

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# FastAPI
APP_NAME=WebAgent API
ENVIRONMENT=production
API_PREFIX=/api
BACKEND_CORS_ORIGINS=https://app.example.com

# Storage
DATABASE_URL=postgresql+asyncpg://webagent:replace-with-strong-password@127.0.0.1:5432/webagent
REDIS_URL=redis://127.0.0.1:6379/0
UPLOAD_MAX_SIZE_BYTES=26214400
ARTIFACT_STORAGE_ENABLED=true
# CCI persistent deployment: /mnt/afs/tj_share/webagent-cci/artifacts
ARTIFACT_STORAGE_ROOT=/var/lib/webagent/artifacts
ARTIFACT_WATCHER_POLL_INTERVAL_SECONDS=0.5
ARTIFACT_WATCHER_STABLE_SECONDS=1.5
ARTIFACT_WATCHER_STABLE_SAMPLES=3
ARTIFACT_WATCHER_SETTLE_TIMEOUT_SECONDS=15

# Auth
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_DEV_AUTH_FALLBACK=false

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
# Comma-separated retired keys retained only while rotating stored credentials.
MODEL_CONFIG_ENCRYPTION_PREVIOUS_KEYS=

# Model gateway
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=

# Hermes runtime
HERMES_CLI_PATH=/usr/local/bin/hermes
HERMES_HOME=/var/lib/webagent/agent-home/.hermes
HERMES_WSL_DISTRIBUTION=Ubuntu

# Agent run limits
AGENT_RUN_IDLE_TIMEOUT_SECONDS=1800
AGENT_RUN_OVERALL_TIMEOUT_SECONDS=7200
AGENT_RUN_EVENT_POLL_INTERVAL_SECONDS=1
SHORT_CHAT_WORKER_INSTANCES=2
WORKER_INSTANCES=4
WORKER_CONCURRENCY=1

# Data cleanup
CLEANUP_ENABLED=true
CLEANUP_INITIAL_DELAY_SECONDS=60
CLEANUP_INTERVAL_SECONDS=21600
CLEANUP_RUNTIME_FILE_MAX_AGE_DAYS=14
CLEANUP_DISCONNECTED_RUN_MAX_AGE_DAYS=30
