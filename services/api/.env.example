APP_NAME=WebAgent API
ENVIRONMENT=local
API_PREFIX=/api
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+asyncpg://webagent:webagent_password@localhost:5432/webagent
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_DEV_AUTH_FALLBACK=true

MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONFIG_ENCRYPTION_PREVIOUS_KEYS=

SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=

HERMES_CLI_PATH=hermes
HERMES_HOME=~/.hermes
HERMES_SKILLS_DIR=
HERMES_WSL_DISTRIBUTION=Ubuntu

AGENT_RUN_IDLE_TIMEOUT_SECONDS=1800
AGENT_RUN_OVERALL_TIMEOUT_SECONDS=7200
AGENT_RUN_EVENT_POLL_INTERVAL_SECONDS=1
UPLOAD_MAX_SIZE_BYTES=26214400
ARTIFACT_PREVIEW_CACHE_ROOT=runtime/artifact-previews
LIBREOFFICE_PATH=
PPTX_PREVIEW_MAX_SLIDES=100
PPTX_PREVIEW_TIMEOUT_SECONDS=120
AGENT_RUN_QUEUE_ENABLED=true
AGENT_RUN_QUEUE_NAME=agent-runs
SHORT_CHAT_QUEUE_NAME=short-chat
AGENT_RUN_WORKSPACE_ROOT=runtime/agent-runs
AGENT_RUNTIME_USER_ROOT=runtime/users
AGENT_ADAPTER_LIMIT_SCOPE=per_user
AGENT_ADAPTER_DEFAULT_CONCURRENCY=1
HERMES_ADAPTER_CONCURRENCY=1
AGENT_ADAPTER_LOCK_POLL_SECONDS=2
AGENT_ADAPTER_LOCK_STATUS_INTERVAL_SECONDS=30
AGENT_ADAPTER_LOCK_TTL_SECONDS=120
AGENT_ADAPTER_LOCK_WAIT_TIMEOUT_SECONDS=3600

SKILLS_UPDATE_ENABLED=true
SKILLS_UPDATE_REPO_URL=https://github.com/OpenSenseNova/SenseNova-Skills.git
SKILLS_UPDATE_BRANCH=
SKILLS_UPDATE_CACHE_DIR=
SKILLS_UPDATE_SOURCE_SUBDIR=.
SKILLS_UPDATE_TIMEZONE=Asia/Shanghai
SKILLS_UPDATE_WEEKDAY=4
SKILLS_UPDATE_HOUR=17
SKILLS_UPDATE_MINUTE=0
SKILLS_UPDATE_RUN_ON_STARTUP=false
