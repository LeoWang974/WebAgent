APP_NAME=WebAgent API
ENVIRONMENT=production
API_PREFIX=/api
BACKEND_CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql+asyncpg://webagent:replace-with-strong-password@127.0.0.1:5432/webagent
REDIS_URL=redis://127.0.0.1:6379/0
UPLOAD_MAX_SIZE_BYTES=26214400

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_DEV_AUTH_FALLBACK=false

MODEL_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key
MODEL_CONFIG_ENCRYPTION_PREVIOUS_KEYS=

SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=

AGENT_RUNTIME_DEFAULT=hermes
OPENCLAW_BASE_URL=ws://127.0.0.1:18789
OPENCLAW_AGENT_ID=main
OPENCLAW_CLI_PATH=/usr/local/bin/openclaw
OPENCLAW_COMMAND_TIMEOUT_SECONDS=600
OPENCLAW_MODE=gateway_cli
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_CLI_PATH=/usr/local/bin/hermes
HERMES_HOME=/var/lib/webagent/agent-home/.hermes
HERMES_SKILLS_DIR=/var/lib/webagent/agent-home/.hermes/skills
HERMES_WSL_DISTRIBUTION=Ubuntu
OPENCLAW_SKILLS_DIR=/var/lib/webagent/openclaw-skills

AGENT_RUN_IDLE_TIMEOUT_SECONDS=1800
AGENT_RUN_OVERALL_TIMEOUT_SECONDS=7200
AGENT_RUN_PPT_EXPORT_TIMEOUT_SECONDS=180
AGENT_RUN_EVENT_POLL_INTERVAL_SECONDS=1

SKILLS_UPDATE_ENABLED=true
SKILLS_UPDATE_REPO_URL=https://github.com/OpenSenseNova/SenseNova-Skills.git
SKILLS_UPDATE_BRANCH=
SKILLS_UPDATE_CACHE_DIR=/var/lib/webagent/sensenova-skills
SKILLS_UPDATE_SOURCE_SUBDIR=.
SKILLS_UPDATE_TIMEZONE=Asia/Shanghai
SKILLS_UPDATE_WEEKDAY=4
SKILLS_UPDATE_HOUR=17
SKILLS_UPDATE_MINUTE=0
SKILLS_UPDATE_RUN_ON_STARTUP=false

CLEANUP_ENABLED=true
CLEANUP_INITIAL_DELAY_SECONDS=60
CLEANUP_INTERVAL_SECONDS=21600
CLEANUP_RUNTIME_FILE_MAX_AGE_DAYS=14
CLEANUP_DISCONNECTED_RUN_MAX_AGE_DAYS=30
